                  "if (pm.response.code === 503) pm.test('typed error', () => pm.expect(pm.response.json().error.code).to.eql('model_unavailable'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buyer checkout (agent chat)",
          "description": "Stages: recommendation, quote, confirmation request, explicit confirmation, PayPal approval, capture, receipt. Needs the API running with a configured model (otherwise Start returns 503 model_unavailable). Starting a run, requesting a quote and approving in PayPal are NOT confirmation; only `user_confirmed: true` on the confirm call can lead to capture, and only after the buyer approved in PayPal. In sandbox mode open `approval_url` from the paypal_approval event as the sandbox buyer.",
          "item": [
            {
              "name": "1. Start run (recommendation + quote + confirmation request)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": \"I need running shoes under $100, all in\",\n  \"budget\": \"100.00\",\n  \"request_id\": \"{{run_id}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.environment.set('run_id', 'postman-' + pm.variables.replaceIn('{{$guid}}').slice(0, 24));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 503) { pm.test('typed model_unavailable', () => pm.expect(pm.response.json().error.code).to.eql('model_unavailable')); return; }",
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "const run = pm.response.json();",
                      "pm.test('awaiting confirmation, nothing charged', () => { pm.expect(run.status).to.eql('awaiting_confirmation'); pm.expect(run.events.some(e => e.type === 'receipt')).to.be.false; });",
                      "const types = run.events.map(e => e.type);",
                      "pm.test('quote then confirmation request then approval offer', () => pm.expect(types.slice(-3)).to.eql(['quote','confirmation_request','paypal_approval']));",
                      "pm.test('seq is ordered', () => pm.expect(run.events.map(e => e.seq)).to.eql(run.events.map((_, i) => i)));",
                      "const conf = run.events.find(e => e.type === 'confirmation_request');",
                      "pm.environment.set('pending_order_id', conf.pending_order_id);",
                      "pm.environment.set('next_seq', String(run.next_seq - 1));",
                      "const ap = run.events.find(e => e.type === 'paypal_approval');",
                      "pm.environment.set('api_paypal_status', ap.status);",
                      "pm.environment.set('paypal_order_id', ap.order_id);",
                      "if (ap.approval_url) pm.environment.set('paypal_approval_url', ap.approval_url);  // secret-grade"
                    ]
                  }
                }
              ]
            },
            {
              "name": "2. Poll (only new events; surfaces buyer approval, never captures)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}?after={{next_seq}}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "const run = pm.response.json();",
                      "pm.test('no capture from polling', () => pm.expect(run.events.some(e => e.type === 'receipt')).to.be.false);",
                      "const ap = run.events.filter(e => e.type === 'paypal_approval').pop();",
                      "if (ap) { pm.environment.set('api_paypal_status', ap.status); pm.test('approved => no approval url', () => { if (ap.status === 'APPROVED') pm.expect(ap.approval_url).to.be.null; }); }",
                      "pm.environment.set('next_seq', String(run.next_seq - 1));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "3. Confirm with user_confirmed=false (expected failure 428)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}/confirm"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pending_order_id\": \"{{pending_order_id}}\",\n  \"user_confirmed\": false\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('428 confirmation_required', () => { pm.response.to.have.status(428); pm.expect(pm.response.json().error.code).to.eql('confirmation_required'); });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "4. Confirm BEFORE PayPal approval (expected failure 402; skipped once approved)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}/confirm"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pending_order_id\": \"{{confirm_probe_id}}\",\n  \"user_confirmed\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Safety: after approval this points at a bogus pending id (404), so it cannot capture.",
                      "pm.environment.set('confirm_probe_id', pm.environment.get('api_paypal_status') === 'APPROVED' ? 'not-the-pending-order' : pm.environment.get('pending_order_id'));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('refused', () => pm.expect(pm.response.code).to.be.oneOf([402, 404]));",
                      "pm.test('typed, no PayPal body', () => { const e = pm.response.json().error; pm.expect(e.code).to.be.oneOf(['payment_failed','pending_order_not_found']); pm.expect(JSON.stringify(e)).to.not.include('debug_id'); });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "5. Confirm (explicit, after buyer approved in PayPal)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}/confirm"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pending_order_id\": \"{{pending_order_id}}\",\n  \"user_confirmed\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Run Poll first and approve the order as the sandbox buyer. Otherwise: 402 ORDER_NOT_APPROVED (recoverable; confirm again after approving).",
                      "pm.test('captured', () => pm.response.to.have.status(200));",
                      "const run = pm.response.json();",
                      "const r = run.events.filter(e => e.type === 'receipt');",
                      "pm.test('exactly one receipt', () => pm.expect(r.length).to.eql(1));",
                      "pm.test('receipt fields', () => { pm.expect(r[0].payment_status).to.eql('COMPLETED'); pm.expect(r[0].idempotency).to.eql('created'); pm.expect(r[0].capture_id).to.be.ok; });",
                      "pm.environment.set('paypal_capture_id', r[0].capture_id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "6. Confirm again (idempotent: still one receipt)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}/confirm"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pending_order_id\": \"{{pending_order_id}}\",\n  \"user_confirmed\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "pm.test('still one receipt, same capture', () => { const r = pm.response.json().events.filter(e => e.type === 'receipt'); pm.expect(r.length).to.eql(1); pm.expect(r[0].capture_id).to.eql(pm.environment.get('paypal_capture_id')); });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "7. Confirm unknown pending order (expected failure 404)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{api_base_url}}/agent/runs/{{run_id}}/confirm"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pending_order_id\": \"does-not-exist\",\n  \"user_confirmed\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('404 pending_order_not_found', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.code).to.eql('pending_order_not_found'); });"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },

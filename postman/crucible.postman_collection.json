{
  "info": {
    "name": "Crucible v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "PayPal sandbox flow + Crucible API. Secrets come from the environment only."
  },
  "item": [
    {
      "name": "PayPal Sandbox",
      "item": [
        {
          "name": "OAuth token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{paypal_base_url}}/v1/oauth2/token"
            },
            "body": {
              "mode": "raw",
              "raw": "grant_type=client_credentials"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{PAYPAL_CLIENT_ID}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{PAYPAL_CLIENT_SECRET}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('bearer', () => pm.expect(j.token_type).to.eql('Bearer'));",
                  "pm.environment.set('paypal_access_token', j.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "postman-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypal_base_url}}/v2/checkout/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"custom_id\": \"postman-{{$guid}}\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"1.00\"\n      }\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"experience_context\": {\n        \"user_action\": \"PAY_NOW\",\n        \"shipping_preference\": \"NO_SHIPPING\",\n        \"return_url\": \"https://example.com/return\",\n        \"cancel_url\": \"https://example.com/cancel\"\n      }\n    }\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypal_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const j = pm.response.json();",
                  "pm.test('exact amount', () => pm.expect(j.purchase_units[0].amount.value).to.eql('1.00'));",
                  "pm.environment.set('paypal_order_id', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paypal_base_url}}/v2/checkout/orders/{{paypal_order_id}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypal_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('known status', () => pm.expect(['CREATED','PAYER_ACTION_REQUIRED','APPROVED','COMPLETED']).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture order (after buyer approval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "capture-{{paypal_order_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypal_base_url}}/v2/checkout/orders/{{paypal_order_id}}/capture"
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypal_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Requires the sandbox buyer to approve first; otherwise expect 422 ORDER_NOT_APPROVED.",
                  "pm.test('completed or not approved', () => pm.expect([201,422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Crucible API",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/health"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/providers/status"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bestbuy disabled', () => pm.expect(pm.response.json().providers.bestbuy.enabled).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Catalog search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/catalog/search?q=running shoes&max_price=100"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('source + as_of stamped', () => { pm.expect(j.source).to.be.a('string'); pm.expect(j).to.have.property('snapshot'); });",
                  "pm.test('budget respected', () => j.products.forEach(p => pm.expect(parseFloat(p.price)).to.be.at.most(100)));",
                  "if (j.products.length) pm.environment.set('product_id', j.products[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Product detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/catalog/products/{{product_id}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Product reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/catalog/products/{{product_id}}/reviews?focus=durability&limit=5"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has availability flag', () => pm.expect(pm.response.json()).to.have.property('reviews_available'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Propose purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/purchase/propose"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"postman\",\n  \"agent_id\": \"postman\",\n  \"product_id\": \"{{product_id}}\",\n  \"variant\": \"\",\n  \"expected_total\": \"{{expected_total}}\",\n  \"budget_cap\": \"{{budget_cap}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.environment.set('pending_order_id', pm.response.json().pending_order_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm purchase (explicit confirmation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/purchase/confirm"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pending_order_id\": \"{{pending_order_id}}\",\n  \"user_confirmed\": true\n}"
            }
          }
        },
        {
          "name": "Ready (configured backends)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/ready"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('booleans only', () => pm.expect(Object.values(pm.response.json().checks).every(v => typeof v === 'boolean')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/config"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('labels data', () => pm.expect(pm.response.json().data_notice).to.include('snapshot'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agent run (503 until a model is configured)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/agent/run"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"running shoes under $100, size 12 or something\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or typed 503', () => pm.expect([200,503]).to.include(pm.response.code));",
                  "if (pm.response.code === 503) pm.test('typed error', () => pm.expect(pm.response.json().error.code).to.eql('model_unavailable'));"
                ]
              }
            }
          ]
        }
      ]
    },
